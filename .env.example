# ---------- Core ----------
APP_ENV=development                 # development | production
SECRET_KEY=change-me-to-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///instance/app.db      # Cloud: postgresql://user:pass@host:5432/dbname
SESSION_COOKIE_SECURE=false                 # true in production (HTTPS)
RATELIMIT_STORAGE_URI=memory://             # Production: redis://host:6379/0

# ---------- Dataset (never modified by the app) ----------
DATASET_PATH=data/original/Combined_All_3_CSV_Files.csv
INDEX_DIR=data/index

# ---------- Embeddings / FAISS ----------
# sentence-transformers (research/production) | hash (offline dev + CI ONLY, not for reported results)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Leave blank to use backend defaults; calibrate with:  flask calibrate-thresholds
RETRIEVAL_MIN_SYMPTOM_SIM=
RETRIEVAL_MIN_FULL_SIM=

# ---------- Gemini (server-side only) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Controlled web-search fallback (optional) ----------
# Google Programmable Search Engine (Custom Search JSON API)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ---------- Whisper ----------
WHISPER_MODEL=small                 # tiny | base | small | medium  (larger = better Tamil/Telugu accuracy)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---------- Follow-up scheduling (hours) ----------
FOLLOWUP_HOURS_LOW=48
FOLLOWUP_HOURS_MEDIUM=24
